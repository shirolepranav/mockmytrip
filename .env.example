# Wanderlost environment variables. Copy to .env.local and fill in values —
# every one of these is optional: the app runs fully on free-tier
# fallbacks (embedded PGlite DB, no email, no AI suggestions) with nothing
# set at all.

# Neon Postgres connection string. Unset in local dev/CI/tests, where the
# app falls back to an embedded PGlite database (see lib/db/client.ts).
DATABASE_URL=

# Session cookie signing secret (HMAC). Falls back to an insecure dev
# default if unset — always set this in any deployed environment.
AUTH_SECRET=

# Resend (booking confirmation emails). Without this, bookings still
# succeed; the confirmation email is skipped and the pass stays viewable
# in-app (see lib/services/bookings.ts).
RESEND_API_KEY=
EMAIL_FROM="Wanderlost <onboarding@resend.dev>"

# LLM API key for the optional "AI suggest itinerary" feature
# (lib/services/ai.ts). Without this, AI suggestions show a friendly
# "the travel muse is resting" message and manual itinerary authoring is
# entirely unaffected. Either name works; LLM_API_KEY takes precedence.
LLM_API_KEY=
ANTHROPIC_API_KEY=

# Web push (Phase 8). Generate a keypair with `npx web-push generate-vapid-keys`
# and paste the public/private values below. Without these set, the push
# opt-in toggle shows a friendly "not available on this device" state and
# nothing else is affected.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# calling /api/push/send on its schedule (see vercel.json). Generate any
# long random string (e.g. `openssl rand -hex 32`); without it set, the
# route always returns 401 and no pushes are ever sent.
CRON_SECRET=

# Canonical production URL — used for metadataBase, robots.txt, sitemap.xml,
# and absolute OG-image URLs. Falls back to https://wanderlost.app locally.
NEXT_PUBLIC_SITE_URL=

# Sentry (Phase 10, error tracking only — no Session Replay, no analytics).
# SENTRY_DSN is server-side, NEXT_PUBLIC_SENTRY_DSN is client-side (they're
# usually the same value). Without these set, Sentry.init() is skipped and
# errors are only visible in server logs. SENTRY_AUTH_TOKEN/SENTRY_ORG/
# SENTRY_PROJECT are CI/Vercel build-time secrets for source-map upload —
# never commit them; without them, source maps just aren't uploaded.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
