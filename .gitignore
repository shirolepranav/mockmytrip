# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Serwist-generated service worker (built by @serwist/next from app/sw.ts
# on every production build — never hand-edited, never committed)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Testing
/test-results/
/playwright-report/
/coverage/

# OS
.DS_Store

# Local embedded DB
/.data/
/data/raw/*
# Small committed fixtures so scripts/seed-pois.test.ts runs offline in CI
!/data/raw/pois
