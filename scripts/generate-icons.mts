/*
 * One-off generator for the PWA manifest icons (Phase 8 task 1). Renders the
 * brand mark (the same paper-plane glyph as components/icons.tsx's
 * IconPlane, on the ink brand color) to PNG via the pre-installed Chromium —
 * no image-processing dependency (sharp/canvas) needed for four static
 * files. Re-run with `npx tsx scripts/generate-icons.mts` only if the mark
 * or brand colors change; the output PNGs are committed, not built on the
 * fly.
 */
import { mkdirSync, writeFileSync } from "node:fs";
import { chromium } from "playwright-core";
import { colors } from "../lib/design/colors";

const OUT_DIR = "public/icons";

/** `size` is the full canvas; `padPct` is the empty margin on each side. */
function markup(size: number, padPct: number): string {
  const inset = size * padPct;
  const inner = size - inset * 2;
  return `<!doctype html><html><body style="margin:0">
    <svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">
      <rect width="${size}" height="${size}" fill="${colors.ink}" />
      <g transform="translate(${inset} ${inset})">
        <svg width="${inner}" height="${inner}" viewBox="0 0 24 24" fill="none"
          stroke="${colors.paper2}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 4 3.6 10.5c-.8.3-.75 1.44.07 1.7l6.13 1.9 1.9 6.13c.25.82 1.4.87 1.7.07L20 3" />
          <path d="m9.8 14.1 10.6-10.4" />
        </svg>
      </g>
    </svg>
  </body></html>`;
}

// Optional override for environments where the Chromium revision under
// PLAYWRIGHT_BROWSERS_PATH doesn't match what this playwright-core version
// would otherwise try to auto-resolve (e.g. a sandbox with a pre-installed
// browser pinned to an older revision). Leave unset for a normal dev setup.
const CHROMIUM_PATH = process.env.ICON_GEN_CHROMIUM_PATH;

async function render(name: string, size: number, padPct: number) {
  const browser = await chromium.launch(
    CHROMIUM_PATH ? { executablePath: CHROMIUM_PATH } : {},
  );
  const page = await browser.newPage({ viewport: { width: size, height: size } });
  await page.setContent(markup(size, padPct));
  await page.screenshot({ path: `${OUT_DIR}/${name}.png` });
  await browser.close();
}

async function main() {
  mkdirSync(OUT_DIR, { recursive: true });
  // "any" icons: modest padding, no OS mask applied.
  await render("icon-192", 192, 0.12);
  await render("icon-512", 512, 0.12);
  // Maskable icons: content must sit inside the ~80%-diameter safe zone
  // that survives any OS mask shape (circle, squircle, rounded square).
  await render("icon-192-maskable", 192, 0.18);
  await render("icon-512-maskable", 512, 0.18);
  writeFileSync(
    `${OUT_DIR}/.gitkeep`.replace(".gitkeep", "README.txt"),
    "Generated by scripts/generate-icons.mts — do not hand-edit; re-run the script instead.\n",
  );
}

main();
